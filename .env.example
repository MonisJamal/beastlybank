# BeastlyBank Environment Configuration
# Replace these values with your actual Discord Bot credentials and BeastlyFC server IDs.

# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# BeastlyFC Server (Guild) ID - STRICT LOCK: Only commands in this server will work
BEASTLYFC_GUILD_ID=123456789012345678

# Role IDs for Bank Staff / Admin permissions (Optional, comma-separated)
BANKER_ROLE_IDS=
ADMIN_ROLE_IDS=

# Database File Path
DATABASE_PATH=beastlybank.db

# Automated Discord Cloud Backup Channel ID (CRITICAL for Render, Heroku, Discloud, Square Cloud)
# When set, the bot automatically uploads database snapshots to this channel and restores them on reboot!
BACKUP_CHANNEL_ID=

